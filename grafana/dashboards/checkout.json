{
  "uid": "checkout-sre-lab",
  "title": "Checkout | confiabilidade",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requisições por resultado (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (status) (rate(lab_requests_total{route=\"/checkout\"}[1m]))", "legendFormat": "{{status}}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Taxa de erro (SLI)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [{ "expr": "job:checkout_error_ratio:rate1m", "legendFormat": "erros / total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latência p95 (segundos)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(lab_request_duration_seconds_bucket{route=\"/checkout\"}[1m])))", "legendFormat": "p95", "refId": "A" }]
    }
  ]
}
